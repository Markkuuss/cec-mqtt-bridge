[Unit]
Description=cec HDMI-CEC to MQTT bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/usr/local/lib/cec-mqtt-bridge
ExecStart=/usr/bin/python3 /usr/local/lib/cec-mqtt-bridge/cec_mqtt_bridge.py -f /etc/cec-mqtt-bridge/config.ini
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
