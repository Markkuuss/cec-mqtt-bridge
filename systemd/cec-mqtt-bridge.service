[Unit]
Description=cec HDMI-CEC to MQTT bridge
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/cec-mqtt-bridge
Environment=PYTHONPATH=/opt/cec-mqtt-bridge/src
ExecStart=/usr/bin/python3 -m cec_mqtt_bridge.bridge -f /etc/cec-mqtt-bridge.ini
Restart=always
RestartSec=300

[Install]
WantedBy=multi-user.target
